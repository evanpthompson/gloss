.env
# Backups of .env hold the same live keys the original does, and plain `.env`
# does not match them. Caught by inspection before a commit, not after.
.env.bak*
.env.*.bak
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# Real prep packs name a company and a person; only the template is checked in.
sessions/*
!sessions/README.md
!sessions/example/
.idea/
.playwright-browsers
# Built by tools/build_kb.py from books that are not ours to redistribute.
# Reproducible; not source.
kb/
