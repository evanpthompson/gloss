# Laptop B (Mac) only — b_server.py reads this
DEEPGRAM_API_KEY=

# Tier 1 enrichment. Pick a provider; everything else about it — the pinned
# model, the kwargs that model takes, its cache floor — comes from its row in
# providers.py, so the four cannot drift apart. Set its key and nothing else.
#
#   anthropic     claude-haiku-4-5    DEFAULT. Phase 3 primary.
#   deepseek      deepseek-v4-flash   Phase 3 fallback link
#   ollama        llama3.2            local; latency unmeasured on this hardware
#   fake          —                   canned cards, mocked E2E suite only
#   google_genai  gemini-3.6-flash    no longer a target; kept working, unmaintained
#
# An unlisted provider is refused at startup rather than attempted.
# GLOSS_PROVIDER=anthropic

ANTHROPIC_API_KEY=                   # https://console.anthropic.com/settings/keys
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey
DEEPSEEK_API_KEY=                    # https://platform.deepseek.com/api_keys

# Vendors tried behind GLOSS_PROVIDER, in order, when it cannot answer. Comma
# separated. Default "deepseek" — a second vendor answers an Anthropic outage
# better than a local model does, and caches are model-scoped so the fallback
# starts cold: this is outage resilience, not a way to spend less.
#
# Every link is preflighted with a live call at startup, and a link whose key is
# missing refuses the whole boot — a fallback you have not proved is one you
# would discover during the outage it exists for. Set this empty to run
# deliberately on a single provider.
# GLOSS_FALLBACKS=deepseek,local
#
# `local` is the glossary built by tools/build_kb.py — no model, no network, no
# tokens, microseconds. It is the floor under the chain, not a first pass: it
# only ever runs when every vendor above it has failed, and it can only produce
# jargon cards. A recall card claims the person's own notes say something, and
# a book is not their notes. If no glossary has been built the link is dropped
# with a warning rather than blocking startup.
# GLOSS_KB=kb/glossary.json
# GLOSS_KB_PROVIDER=deepseek   # which vendor tools/build_kb.py reads the books with

# Overriding the pinned model is allowed, but you must then own its kwargs too:
# setting GLOSS_MODEL_KWARGS without GLOSS_MODEL is refused, because an
# unpinned kwargs override silently follows you onto the next provider you
# switch to and fails there. Off-profile models also warn that the cache floor
# in providers.py no longer describes what you are running.
# GLOSS_MODEL=claude-haiku-4-5
# GLOSS_MODEL_KWARGS={}

# Anthropic only. 5m is the API default; a cache write does not refresh an
# earlier breakpoint's clock, so a five-minute lull evicts the prefix and the
# next turn pays full input price. 1h costs 2x on the one write, not 1.25x.
# GLOSS_CACHE_TTL=1h

# Cache counters are logged once per run. Set this to log them every turn —
# caching fails silently, so this is the only way to see it stop working.
# GLOSS_LOG_CACHE=1

# Which prep pack to load — one directory of *.md per conversation.
# GLOSS_SESSION=sessions/example
# GLOSS_MAX_CARDS=3
# GLOSS_MIN_CHARS=25          # shorter interviewer turns never trigger a call

# How long a card stays up after the last turn that raised its topic, refreshed
# whenever the topic recurs. ~90s is two or three conversational turns: long
# enough that a glance away and back still finds it, short enough that the
# screen does not fill with things nobody is discussing any more.
# GLOSS_CARD_TTL_S=90
# Errors clear far faster, and sit outside GLOSS_MAX_CARDS so a transient
# outage never costs a real card. A failure that has already recovered must not
# keep claiming the tool is down — the next good turn will not overwrite it,
# because zero cards is the normal result and broadcasts nothing.
# GLOSS_ERROR_TTL_S=20
# The whole conversation is sent every turn — a rolling window was the amnesia
# this tool exists to not have. Bounded only so a very long call cannot outgrow
# the model's context; on overflow the oldest turns are dropped and logged.
# GLOSS_MAX_TRANSCRIPT_TOKENS=100000

# Optional overrides, all have sane defaults — see b_server.py / a_listener.py
# B_SERVER_HOST=0.0.0.0
# B_SERVER_PORT=8765
# B_SERVER_SAMPLE_RATE=48000

# Speech-to-text endpoint. Unset = real Deepgram production. Set this to
# point b_server.py at a mock/local endpoint instead, e.g. for offline
# testing (see the gloss-e2e repo).
# DEEPGRAM_WS_URL=ws://mock-deepgram:9010

# Laptop A (Windows) only — a_listener.py reads this
# B_SERVER_URL=ws://192.168.1.100:8765
# A_LISTENER_SAMPLE_RATE=48000
# A_LISTENER_CHUNK_FRAMES=4800
# A_LISTENER_MIC_NAME=
