# Laptop B (Mac) only — b_server.py reads this
DEEPGRAM_API_KEY=

# Tier 1 enrichment. Provider-agnostic via LangChain: set the provider, the
# model, and that provider's own key. Set exactly ONE of the blocks below.
# GLOSS_PROVIDER=anthropic          # anthropic | google_genai | deepseek | ollama | ...
#                                   # 'fake' = canned cards, no model called,
#                                   # used by the mocked E2E suite only.

# --- Anthropic (Phase 3 primary) -------------------------------------------
# GLOSS_PROVIDER=anthropic
# GLOSS_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=                   # https://console.anthropic.com/settings/keys
# Leave GLOSS_MODEL_KWARGS EMPTY here. Haiku 4.5 has no thinking by default,
# which is what the 1-2s budget wants, and thinking_level is a Gemini
# parameter that this provider rejects.
#
# The prep pack must clear 4096 tokens or nothing caches — Haiku 4.5 has the
# highest minimum cacheable prefix of any current Claude model. Check with
# `uv run python tools/check_pack.py sessions/<name> --provider anthropic`.
# GLOSS_CACHE_TTL=1h                # "1h" or "5m"; see b_server.py for why 1h

# --- Google Gemini (Phase 2 default) ---------------------------------------
# GLOSS_PROVIDER=google_genai
# GLOSS_MODEL=gemini-3.6-flash
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey
# Provider-specific knobs as JSON, kept out of the code. GEMINI ONLY.
# Measured: "minimal" 1.3-1.7s vs 2.7-4.4s default vs 15.6s on "low". Not
# optional on Gemini, and must be unset on any other provider.
GLOSS_MODEL_KWARGS={"thinking_level": "minimal"}

# Cache counters are logged once per run. Set this to log them every turn —
# caching fails silently, so this is the only way to see it stop working.
# GLOSS_LOG_CACHE=1

# Which prep pack to load — one directory of *.md per conversation.
# GLOSS_SESSION=sessions/example
# GLOSS_MAX_CARDS=3
# GLOSS_MIN_CHARS=25          # shorter interviewer turns never trigger a call
# GLOSS_WINDOW_TURNS=6        # transcript turns sent as context

# Optional overrides, all have sane defaults — see b_server.py / a_listener.py
# B_SERVER_HOST=0.0.0.0
# B_SERVER_PORT=8765
# B_SERVER_SAMPLE_RATE=48000

# Speech-to-text endpoint. Unset = real Deepgram production. Set this to
# point b_server.py at a mock/local endpoint instead, e.g. for offline
# testing (see the gloss-e2e repo).
# DEEPGRAM_WS_URL=ws://mock-deepgram:9010

# Laptop A (Windows) only — a_listener.py reads this
# B_SERVER_URL=ws://192.168.1.100:8765
# A_LISTENER_SAMPLE_RATE=48000
# A_LISTENER_CHUNK_FRAMES=4800
# A_LISTENER_MIC_NAME=
